# ============================================================================
# 1. ENVIRONMENT & BASE URLS (SERVER-ONLY)
# ============================================================================
NODE_ENV="development" # Set to "production" on deployment (turns off debug mode & stack traces)
APP_BASE_URL="http://localhost:3000"
ALLOWED_CORS_ORIGINS="http://localhost:3000"

# ============================================================================
# 2. MONGODB DATABASE & CONNECTION POOLING (FREE MONGODB ATLAS M0 TIER)
# Tip: Select the MongoDB Atlas region closest to your hosting server (e.g., ap-south-1 or us-east-1)
# ============================================================================
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/eden_bliss?retryWrites=true&w=majority&appName=EdenBliss"
MONGODB_MAX_POOL_SIZE="10"
MONGODB_MIN_POOL_SIZE="2"
MONGODB_CONNECT_TIMEOUT_MS="5000"
MONGODB_SOCKET_TIMEOUT_MS="30000"

# ============================================================================
# 3. REDIS CACHE & RATE LIMITING (FREE UPSTASH REDIS OR LOCAL IN-MEMORY FALLBACK)
# If left empty, the app automatically falls back to a free in-memory LRU cache
# ============================================================================
REDIS_URL="redis://default:<password>@<endpoint>.upstash.io:6379"
CACHE_DEFAULT_TTL_SECONDS="300"

# ============================================================================
# 4. AUTHENTICATION, JWT & SECURITY SECRETS
# Generate in terminal using: openssl rand -base64 64
# ============================================================================
JWT_ACCESS_SECRET="replace_with_64_char_random_hex_or_base64_secret_key_for_access"
JWT_REFRESH_SECRET="replace_with_64_char_random_hex_or_base64_secret_key_for_refresh"
JWT_EXPIRES_IN="7d"
BCRYPT_SALT_ROUNDS="12"
CSRF_SECRET="replace_with_random_csrf_secret_key"

# ============================================================================
# 5. WEBHOOK & BACKGROUND QUEUE SIGNING (HMAC-SHA256)
# ============================================================================
WEBHOOK_SECRET="replace_with_hmac_sha256_webhook_signing_secret"
INTERNAL_JOB_QUEUE_SECRET="replace_with_internal_background_worker_secret"

# ============================================================================
# 6. RATE LIMITING & EXTERNAL API TIMEOUTS
# ============================================================================
RATE_LIMIT_WINDOW_MS="60000"           # 1 minute window
RATE_LIMIT_MAX_REQUESTS_PUBLIC="60"    # 60 req/min per IP for browsing
RATE_LIMIT_MAX_REQUESTS_AUTH="5"       # 5 req/min per IP for login/signup/password reset
EXTERNAL_API_TIMEOUT_MS="5000"         # 5 second hard timeout for any external call

# ============================================================================
# 7. PRIVATE FILE UPLOAD & STORAGE SETTINGS (100% FREE LOCAL PRIVATE STORAGE)
# ============================================================================
PRIVATE_STORAGE_DIR="./storage/private-uploads"
PUBLIC_MEDIA_CDN_PREFIX="/api/media"
MAX_FILE_UPLOAD_SIZE_BYTES="2097152"   # 2MB strict limit
ALLOWED_IMAGE_MIME_TYPES="image/jpeg,image/png,image/webp,image/avif"

# ============================================================================
# 8. OPENTELEMETRY & SLOW REQUEST TRACING (FREE BUILT-IN / OTLP)
# ============================================================================
OTEL_SERVICE_NAME="eden-bliss-ecommerce"
SLOW_REQUEST_THRESHOLD_MS="400"        # Log warning if any DB query or route exceeds 400ms

# ============================================================================
# 9. INITIAL ADMIN BOOTSTRAP (ONLY USED DURING INITIAL SEEDING, LOCKED IN PROD)
# ============================================================================
ENABLE_SEED_ENDPOINT="false"           # Keep "false" in production to lock dangerous tools
INITIAL_ADMIN_EMAIL="admin@edenbliss.com"
INITIAL_ADMIN_PASSWORD="ChangeThisStrongAdminPassword!2026"
